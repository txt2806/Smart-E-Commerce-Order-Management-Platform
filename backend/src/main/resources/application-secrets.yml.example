# Mẫu cấu hình bảo mật - Sao chép file này thành application-secrets.yml và điền thông tin của bạn
spring:
  datasource:
    url: jdbc:mysql://YOUR_DB_HOST:3306/defaultdb?sslMode=REQUIRED
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD

app:
  jwt:
    secret: YOUR_BASE64_256BIT_SECRET_KEY_HERE
    access-expiration: 900000     # 15 phút (900,000 ms)
    refresh-expiration: 604800000  # 7 ngày (604,800,000 ms)
  google:
    client-id: "YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com"
